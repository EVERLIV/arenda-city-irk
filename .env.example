# SSH tunnel to Postgres (Timeweb node kvmnvm-673)
SSH_HOST=72.56.247.221
SSH_USER=root
SSH_PORT=22
# SSH_IDENTITY_FILE=C:\Users\Admin\.ssh\id_ed25519
SSH_LOCAL_DB_PORT=54322
